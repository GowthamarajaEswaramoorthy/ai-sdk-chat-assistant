# ============================================
# commercetools Configuration
# ============================================
# Get these from: https://mc.commercetools.com
# Settings → Developer settings → API clients

CTP_AUTH_URL=https://auth.us-central1.gcp.commercetools.com
CTP_API_URL=https://api.us-central1.gcp.commercetools.com
CTP_PROJECT_KEY=your-project-key
CTP_CLIENT_ID=your-client-id
CTP_CLIENT_SECRET=your-client-secret
CTP_SCOPE=manage_project:your-project-key

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=localhost:3000,localhost:5173,localhost:8080

# ============================================
# AI Provider Configuration
# ============================================
# Choose one: openai or anthropic

# Option 1: OpenAI (GPT models)
# Get your API key from: https://platform.openai.com/api-keys
AI_PROVIDER=openai
AI_MODEL=gpt-4o
OPENAI_API_KEY=sk-your-openai-api-key-here

# Alternative OpenAI models:
# AI_MODEL=gpt-4o-mini      # Faster, cheaper
# AI_MODEL=gpt-4-turbo      # Previous generation

# Option 2: Anthropic (Claude models)
# Get your API key from: https://console.anthropic.com
# AI_PROVIDER=anthropic
# AI_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ============================================
# Tools Configuration
# ============================================
# This enables customer service tools along with product, cart, and order tools
AVAILABLE_TOOLS={"products":{"read":true},"category":{"read":true},"cart":{"read":true},"order":{"read":true},"customer":{"read":true}}

# ============================================
# Optional Configuration
# ============================================
MAX_STEPS=25
SYSTEM_PROMPT=You are a helpful customer service assistant for an e-commerce platform. Your primary goal is to assist customers with their inquiries about orders, products, and account information.

# ============================================
# Authentication
# ============================================
# Secret key for JWT token verification
# IMPORTANT: Change this to a strong random value in production!
JWT_SECRET=my-secret-key-change-this-in-production

# ============================================
# Instructions
# ============================================
# 1. Replace all "your-xxx-here" values with your actual credentials
# 2. For commercetools: Get from Merchant Center
# 3. For OpenAI: Get from platform.openai.com/api-keys
# 4. Save this file as ".env" in the chat folder
# 5. Run: yarn install && yarn start:dev
